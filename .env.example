# ==============================================================================
# Course 4 Teaching Task Manager — Environment Variable Template (Slot 5 Production Ready)
# ==============================================================================
# RULE: Never commit real production secrets or active credentials to version control.
# Copy this file to .env or .env.local for local development.
# In hosting dashboards (Render, Vercel), set these as environment variables.
# ==============================================================================

# Node Runtime Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Backend Server Listening Port (defaults to 3000)
PORT=3000

# Database Connection URL:
# - Local SQLite (default): "file:./prisma/dev.db"
# - Local Test Database:   "file:./prisma/test.db"
# - Production PostgreSQL: "postgresql://<user>:<password>@<neon-host>.neon.tech/<dbname>?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

# Permitted CORS Origins (comma-separated for multiple origins, or single URL):
# - Development: "http://localhost:5173"
# - Production:  "https://your-team-app.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# Frontend API Target URL (used by Vite frontend in apps/web)
# - Development: "http://localhost:3000"
# - Production:  "https://your-api.onrender.com"
VITE_API_URL="http://localhost:3000"

# Educational Incident Drill Simulation Mode ('false' | 'true')
# When 'true' in non-production or drill environment, enables reversible simulated outages.
# MUST be false or unset in normal production traffic.
INCIDENT_DRILL_ENABLED=false
