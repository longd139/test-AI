{
  "name": "course4-teaching-task-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"npm run dev -w @course4/api\" \"npm run dev -w @course4/web\"",
    "dev:api": "npm run dev -w @course4/api",
    "dev:web": "npm run dev -w @course4/web",
    "build": "npm run build -w @course4/shared && npm run build -w @course4/api && npm run build -w @course4/web",
    "pretest": "npm run build -w @course4/shared",
    "test": "npm run test -w @course4/shared && npm run test -w @course4/api && npm run test -w @course4/web && vitest run tests/security tests/bug-hunt",
    "test:security": "vitest run tests/security",
    "test:bugs": "vitest run tests/bug-hunt",
    "pretest:e2e": "npm run build -w @course4/shared && tsx e2e/prepare-db.ts",
    "test:e2e": "playwright test",
    "pretest:e2e:headed": "npm run build -w @course4/shared && tsx e2e/prepare-db.ts",
    "test:e2e:headed": "playwright test --headed",
    "pretypecheck": "npm run build -w @course4/shared",
    "typecheck": "npm run typecheck -w @course4/shared && npm run typecheck -w @course4/api && npm run typecheck -w @course4/web",
    "prelint": "npm run build -w @course4/shared",
    "lint": "npm run lint -w @course4/shared && npm run lint -w @course4/api && npm run lint -w @course4/web",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/reset.ts",
    "security:audit": "npm audit",
    "security:scan": "npm run security:audit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@prisma/client": "^6.4.0",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
