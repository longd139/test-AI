+import React from 'react';
+
+interface DueDateBadgeProps {
+  dueDate: string;
+  customNote?: string;
+}
+
+export const DueDateBadge: React.FC<DueDateBadgeProps> = ({ dueDate, customNote }) => {
+  const isPast = new Date(dueDate).getTime() < Date.now();
+
+  return (
+    <div className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${
+      isPast ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-700'
+    }`}>
+      <span>Due: {dueDate}</span>
+      {customNote && (
+        // CRITICAL SECURITY FLAW: XSS via dangerouslySetInnerHTML (Both AI and Human catch)
+        <span
+          className="ml-1 text-[11px] italic"
+          dangerouslySetInnerHTML={{ __html: customNote }}
+        />
+      )}
+    </div>
+  );
+};
