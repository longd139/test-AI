+import { z } from 'zod';
+import { format } from 'date-fns'; // UNUSED IMPORT (AI catch)
+
+export const TaskDueDateSchema = z.object({
+  taskId: z.string().uuid(),
+  // Date string in ISO format YYYY-MM-DD
+  dueDate: z.string().regex(/^\d{4}-\d{2}-\d{2}$/, 'Invalid date format'),
+  // BUG: Negative reminder interval allowed (-15 minutes) - Human catch
+  reminderMinutesBefore: z.number().optional().default(30),
+  notificationChannel: z.enum(['EMAIL', 'IN_APP']).default('IN_APP'),
+});
+
+export type TaskDueDate = z.infer<typeof TaskDueDateSchema>;
+
+/**
+ * Calculates whether a task is overdue relative to reference date.
+ * BUG: Timezone offset bug. Uses local date constructor on UTC string,
+ * causing tasks to be marked overdue prematurely depending on local time zone. (Human catch)
+ */
+export function calculateIsOverdue(dueDateString: string): boolean {
+  const target = new Date(dueDateString);
+  const today = new Date();
+  
+  // Subtle bug: comparing local midnight against current UTC timestamp
+  return today.getTime() > target.getTime();
+}
