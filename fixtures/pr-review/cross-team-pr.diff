+import { Router, Request, Response } from 'express';
+import { TaskDueDateSchema } from '@course4/shared';
+import { prisma } from '../db.js';
+
+export const remindersRouter = Router();
+
+// In-memory reminder schedule table
+const reminderQueue: Array<{ id: string; taskId: string; fireAt: Date }> = [];
+
+/**
+ * POST /api/reminders - schedule a reminder for a task
+ */
+remindersRouter.post('/api/reminders', async (req: Request, res: Response) => {
+  const parseResult = TaskDueDateSchema.safeParse(req.body);
+  if (!parseResult.success) {
+    return res.status(400).json({ error: parseResult.error.issues[0].message });
+  }
+
+  const { taskId, dueDate, reminderMinutesBefore } = parseResult.data;
+
+  // Typo in variable name (AI catch)
+  const isOverude = new Date(dueDate).getTime() < Date.now();
+  if (isOverude) {
+    return res.status(400).json({ error: 'Cannot schedule reminder for past due date' });
+  }
+
+  const fireAt = new Date(new Date(dueDate).getTime() - reminderMinutesBefore * 60 * 1000);
+  const reminder = {
+    id: `rem-${Date.now()}`,
+    taskId,
+    fireAt,
+  };
+  reminderQueue.push(reminder);
+
+  res.status(201).json({ message: 'Reminder scheduled', reminder });
+});
+
+/**
+ * GET /api/reminders/:taskId - get reminder status
+ */
+remindersRouter.get('/api/reminders/:taskId', (req: Request, res: Response) => {
+  const found = reminderQueue.find((r) => r.taskId === req.params.taskId);
+  if (!found) {
+    return res.status(404).json({ error: 'No reminder scheduled' });
+  }
+  res.json(found);
+});
